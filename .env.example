# =============================================================================
# Variables de entorno de ejemplo.
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas el archivo `.env` con secretos al repositorio.
# =============================================================================

# ------------------------- Base de datos (PostgreSQL + PostGIS) --------------
POSTGRES_USER=geo
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=geolocalizador
# Por defecto se expone en 5433 para no chocar con un PostgreSQL nativo en 5432.
POSTGRES_PORT=5433

# Cadena de conexion usada por Prisma (backend).
DATABASE_URL=postgresql://geo:cambia_esta_clave@localhost:5433/geolocalizador?schema=public

# ------------------------------- Backend (API) -------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# En despliegue, la plataforma (Render) inyecta `PORT` y tiene prioridad sobre
# API_PORT. En local no se define: la API escuchara en API_PORT.
# PORT=10000

# Secreto para firmar los JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=reemplaza_con_un_secreto_largo_y_aleatorio
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=reemplaza_con_otro_secreto_largo_y_aleatorio
JWT_REFRESH_TTL=30d

# Clave de cifrado en reposo para coordenadas sensibles (AES-256-GCM).
# Debe ser una cadena hexadecimal de 64 caracteres (32 bytes).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=reemplaza_con_64_caracteres_hexadecimales

# Origenes permitidos para CORS (separados por coma).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Minutos tras los cuales una ubicacion se considera de un dispositivo
# desconectado (estado OFFLINE). Entre 2 minutos y este valor el estado es STALE.
STALE_AFTER_MINUTES=15

# ------------------------------- Administracion ------------------------------
# Correos promovidos automaticamente al rol SUPERADMIN (separados por coma).
# Es una lista de confianza del operador: el usuario no puede auto-promocionarse.
SUPERADMIN_EMAILS=admin@geo.test

# --------------------- Geocodificacion inversa (direcciones) ----------------
# Proveedor: disabled | nominatim (OpenStreetMap, sin clave) | google.
# La clave se guarda SOLO en el backend; nunca se envia a la app movil.
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_BASE_URL=
GEOCODING_TIMEOUT_MS=4000
# Intervalo minimo entre llamadas al proveedor (Nominatim: 1 peticion/segundo).
GEOCODING_MIN_INTERVAL_MS=1100
GEOCODING_CACHE_TTL_DAYS=30
GEOCODING_LANGUAGE=es
GEOCODING_USER_AGENT=geolocalizador-movil/0.1 (proyecto academico)

# ------------------------------- Panel web ----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ------------------------------- App movil ----------------------------------
# URL de la API que consumira la app Expo.
EXPO_PUBLIC_API_URL=http://localhost:3001
